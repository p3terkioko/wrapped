# Local development overrides. Copy to .env.local (gitignored).
# Loaded BEFORE .env, so these values win. Spotify credentials still come from .env.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&sslmode=disable&pgbouncer=true"
ENABLE_SCHEDULER=false
NODE_ENV=development
PORT=3000
